JWT_SECRET=please-change-this-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 必填：Travelpayouts Data API（免费联盟注册）
# https://www.travelpayouts.com/ → Programs → Aviasales → API
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKET=cn
# TRAVELPAYOUTS_REQUEST_DELAY=0.2
# 默认直连 API；若必须走代理再取消注释（并确保代理软件已启动）
# HTTPS_PROXY=http://127.0.0.1:7897
# TRAVELPAYOUTS_PROXY=http://127.0.0.1:7897

# OTA 核验：对候选打开列表页解析真价（携程→去哪儿→飞猪→Google Flights）
# VERIFY_TOP_K=10
# CTRIP_VERIFY_TIMEOUT_MS=45000
# CTRIP_VERIFY_DELAY_SEC=1.5
# 默认无头；若携程/去哪儿频繁 WhaleGuard，可改为 false（会弹浏览器窗口）
# OTA_VERIFY_HEADLESS=true

# 禁止生产扫价的演示开关（默认 false；true 时扫价会被拒绝）
USE_DEMO=false

MAX_CONCURRENT_SCANS=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
