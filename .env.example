JWT_SECRET=please-change-this-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 必填：Travelpayouts Data API（免费联盟注册）
# https://www.travelpayouts.com/ → Programs → Aviasales → API
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKET=cn
# TRAVELPAYOUTS_REQUEST_DELAY=0.2
# 默认直连 API；若必须走代理再取消注释（并确保代理软件已启动）
# HTTPS_PROXY=http://127.0.0.1:7897
# TRAVELPAYOUTS_PROXY=http://127.0.0.1:7897

# OTA 核验两阶段：Google 密核（可加密）→ 携程 H5 精修头部
OTA_VERIFY_PROVIDERS=google,ctrip_h5
# OTA_PROXY=socks5://127.0.0.1:40000
# 携程 H5 登录 Cookie（仅 Phase B 精修使用）
# OTA_CTRIP_CTICKET=
# CTRIP_CTICKET=
# Google 密核池 / 成功早停 / 邻域加密（越高越准、越慢，受 2G 机器与预算约束）
# GOOGLE_VERIFY_MAX=60
# GOOGLE_VERIFY_TARGET_OK=32
# GOOGLE_NEIGHBOR_EXTRA=24
# GOOGLE_VERIFY_DELAY_SEC=0.6
# 携程精修头部条数与间隔
# CTRIP_H5_REFINE_TOP=6
# CTRIP_H5_VERIFY_DELAY_SEC=2.5
# 整次核验墙钟预算（秒）
# VERIFY_BUDGET_SEC=1500
# VERIFY_TOP_K=10
# CTRIP_VERIFY_TIMEOUT_MS=120000
# CTRIP_VERIFY_DELAY_SEC=1.5
# 默认无头；云上建议 false + xvfb
# OTA_VERIFY_HEADLESS=false

# 禁止生产扫价的演示开关（默认 false；true 时扫价会被拒绝）
USE_DEMO=false

# 2G 内存云主机建议设为 1；本机开发可设 2
MAX_CONCURRENT_SCANS=1

# 博客公开部署：免登录 + guest Cookie + 关闭 admin
PUBLIC_MODE=true
# 每 IP 每小时扫价次数上限（创建任务 + 立即扫描合计）
PUBLIC_SCAN_LIMIT_PER_HOUR=5
# 公开扫价 IP 白名单（逗号分隔，命中后不限次；本机 127.0.0.1 / ::1 始终放行）
# PUBLIC_SCAN_IP_WHITELIST=203.0.113.10,198.51.100.20
CORS_ORIGINS=https://www.krisnote.online,https://krisnote.online,http://localhost:3000,http://127.0.0.1:3000
