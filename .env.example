# 飞书应用凭证 (必填 - 用于机器人)
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=your_app_secret_here

# 飞书 Webhook 地址 (可选 - 用于 push_to_group.bat)
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id

# Amadeus 航班 API (可选 - 不填则机器人/推送默认用演示数据)
# 免费注册: https://developers.amadeus.com/register
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here
# 机器人拉取报价时的货币 (默认 CNY)
# AMADEUS_CURRENCY=CNY

# 一次性推送到群: USE_DEMO=0 且配好 Amadeus 时用真实数据
# USE_DEMO=1

# 相邻 Amadeus 请求间隔（秒），略增大可降低限流概率
# AMADEUS_REQUEST_DELAY=0.2

# 飞书机器人同时进行的真实搜索任务上限（演示模式也占用槽位）
# BOT_MAX_CONCURRENT_SEARCHES=2
